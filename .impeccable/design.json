  "narrative": {
    "northStar": "Interactive mathematics exhibit",
    "overview": "The interface uses clear type, exact diagrams and generous space to make unfamiliar research understandable. Figures carry relationships; short labels identify the parts. Detailed reading remains available through explicit controls.\n\nWhite and pale blue form the reading ground. Navy anchors the text, cobalt identifies interaction, and restrained semantic colors distinguish parts of a comparison. The design supports both visual explanation and honest progress reporting.",
    "keyCharacteristics": [
      "Precise geometric diagrams with consistent strokes.",
      "Readable lettering and clear control states.",
      "Additional detail appears on demand."
    ],
    "rules": [
      {
        "name": "The Label Rule",
        "body": "A status, data group or comparison remains identifiable without its color.",
        "section": "colors"
      }
    ],
    "dos": [
      "Do pair color with an explicit label.",
      "Do use the existing geometric SVG stroke system.",
      "Do preserve visible keyboard focus and reduced-motion behavior.",
      "Do identify illustrative figures and provisional settings."
    ],
    "donts": [
      "Don't replace the infographic with a wall of paragraphs.",
      "Don't present illustrative values as measured results.",
      "Don't use a decoration in place of an explanatory figure."
    ]
  }
